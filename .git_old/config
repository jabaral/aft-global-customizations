[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[remote "origin"]
	url = https://git-codecommit.ca-central-1.amazonaws.com/v1/repos/aft-global-customizations
	fetch = +refs/heads/*:refs/remotes/origin/*
[defender "bypass"]
